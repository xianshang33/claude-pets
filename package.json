{
  "name": "claude-pet",
  "version": "0.1.0",
  "private": true,
  "description": "macOS Electron desktop pet for Claude Code.",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "start": "npm run build && electron .",
    "dev": "tsx scripts/dev.ts",
    "build": "npm run typecheck && vite build && tsx scripts/build-electron.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "vitest run --config vitest.config.ts tests/e2e/electronApp.e2e.test.ts",
    "test:e2e:claude": "CLAUDE_CODE_REAL_E2E=1 vitest run --config vitest.config.ts tests/e2e/claudeCode.e2e.test.ts",
    "simulate:bridge": "tsx scripts/send-event.ts"
  },
  "devDependencies": {
    "@types/node": "20.17.57",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/wait-on": "^5.3.4",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^38.8.6",
    "esbuild": "0.25.11",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "^5.4.21",
    "vitest": "2.1.9",
    "wait-on": "8.0.4"
  }
}
